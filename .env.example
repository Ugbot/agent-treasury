# Stripe SANDBOX keys only. Live keys (sk_live_/rk_live_) are rejected.
# Use a STANDARD sk_test_ key: a claimable-sandbox rkcs_test_ key cannot do Connect or Issuing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Written by `uv run python scripts/bootstrap_sandbox.py` (.treasury-state.json); set by hand if you prefer.
STRIPE_CONNECT_ACCOUNT_A=acct_...   # merchant
STRIPE_CONNECT_ACCOUNT_B=acct_...   # driver
TREASURY_DB=treasury.sqlite
# Agent model (without it the agent runs GOAP-only and says so)
ANTHROPIC_API_KEY=
# Cognee: Cloud = COGNEE_SERVICE_URL + COGNEE_API_KEY; local = LLM_API_KEY. Without either, explanations come from the audit log.
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
LLM_API_KEY=
